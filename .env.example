VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Push notifications (Web Push / VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# Set the private key as a Supabase secret: supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Super-admin allow-list (comma-separated emails). Controls platform-owner-only
# tooling such as the venue-claim QR on venue pages. Defaults to the founder email.
VITE_SUPERADMIN_EMAILS=christianshanahan@gmail.com
# Wynaxa Hub base URL (venue manager). Override for staging.
VITE_HUB_URL=https://hub.wynaxa.com
