# Supabase CLI placeholder migrations — generated by `db pull`, no content of
# their own. They are not part of the schema history.
supabase/migrations/*_placeholder.sql

# One-off generated data scripts. REBUILD_RATINGS_*.sql is hundreds of INSERT
# rows of real player rating history — it belongs in a run log, not the repo.
REBUILD_RATINGS_*.sql

# Local preview harness. Renders real pages against fixtures for screenshots;
